# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-south1          # optional — defaults to asia-south1
GEMINI_MODEL=gemini-3.5-flash              # optional — this is the default

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=your_personal_chat_id     # get this from @userinfobot
WEBHOOK_DOMAIN=https://your-cloudrun-url.run.app  # leave empty for local polling

# Scheduler auth (used to protect the manual /scheduler/trigger endpoint)
SCHEDULER_SECRET=replace_with_random_secret

# Port (Cloud Run sets this automatically)
PORT=3000
